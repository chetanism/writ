{
  "mode": "solo",
  "registry": "canon/spec/ID-REGISTRY.md",
  "work_orders": "canon/process/work-orders",
  "slices": "canon/process/slices",
  "decisions": "canon/decisions",
  "coverage_out": "canon/process/COVERAGE.md",
  "queue_out": "canon/process/SLICE-QUEUE.md",
  "index_out": "canon/INDEX.md",
  "changelog": "canon/spec/CHANGELOG.md",
  "changelog_max_chars": 240,
  "registers": [
    "canon/spec/requirements/*/index.md",
    "canon/spec/invariants.md",
    "canon/spec/compliance.md",
    "canon/spec/strategic-decisions.md",
    "canon/spec/personas.md",
    "canon/spec/milestones.md",
    "canon/spec/dependencies.md",
    "canon/spec/risks.md",
    "canon/spec/assumptions.md",
    "canon/spec/out-of-scope.md",
    "canon/spec/questions.md",
    "canon/spec/debt.md",
    "canon/spec/CHANGELOG.md"
  ],
  "narrative": [
    "canon/spec/BRD.md",
    "canon/spec/glossary.md"
  ],
  "tests": {
    "globs": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.turbo/**"
    ],
    "annotation": "\\[(?P<id>[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z0-9.]+)+)\\]"
  },
  "placeholder_scan": {
    "include": [
      "canon/**/*.md",
      "CLAUDE.md",
      ".claude/skills/**/*.md",
      ".github/workflows/*.yml"
    ],
    "exclude": [
      "canon/process/templates/**",
      "canon/decisions/template.md",
      "canon/process/COVERAGE.md",
      "canon/INDEX.md",
      "canon/maintenance/audits/**"
    ]
  },
  "reference_scan": {
    "include": [],
    "exclude": []
  },
  "context_budget": {
    "files": [
      "CLAUDE.md"
    ],
    "warn_chars": 16000,
    "max_chars": 24000
  },
  "size_budget": {
    "S": 150,
    "M": 400,
    "L": 0
  },
  "enforce": {
    "default": [
      "**"
    ],
    "annotations": null,
    "work_order": null
  },
  "maintenance": "canon/maintenance",
  "phases": [
    {
      "code": "P01",
      "name": "Foundation"
    }
  ],
  "wip_limit": 0,
  "tracker": "github",
  "requirements": {
    "dir": "canon/spec/requirements",
    "families": [
      "FR",
      "INV"
    ],
    "target_column": "Target",
    "require_detail_for_satisfied": false
  },
  "scenarios": {
    "dir": "canon/qa/scenarios",
    "families": [
      "FR",
      "INV"
    ],
    "commands": [],
    "require_scenarios_for_reviewed_detail": false
  },
  "changes": {
    "dir": "canon/spec/changes",
    "family": "CR"
  }
}
